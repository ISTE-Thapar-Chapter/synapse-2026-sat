# ========================================================
# Frontend (Client) Environment Variables — For Vercel Hosting
# Configure these in your Vercel Project Settings > Environment Variables
# ========================================================

# Base URL for the Express API running on AWS EC2
# Example: https://api.yourdomain.com/api or http://<EC2-PUBLIC-IP>:5000/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Web Client ID from Google Cloud Console
# Make sure your Vercel URL (e.g. https://your-project.vercel.app)
# is listed under "Authorized JavaScript origins" in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

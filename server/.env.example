# ========================================================
# Backend (Server) Environment Variables — For AWS EC2 Hosting
# Place these in /var/www/synapse-server/.env on your EC2 instance
# NEVER commit production credentials to source control
# ========================================================

# Server listening port (default: 5000)
PORT=5000
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas or self-hosted MongoDB on EC2)
# Example: mongodb+srv://<dbuser>:<dbpassword>@cluster0.xxxx.mongodb.net/synapse_2026?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/synapse_2026

# JWT signing secret (use a secure 64+ char random hex string)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_production_secret_key_64_chars

# Initial administrator bootstrap account
# This account is provisioned automatically with 'admin' role on first server boot
ADMIN_INITIAL_EMAIL=singlayush1938@gmail.com
ADMIN_INITIAL_NAME=ISTE Administrator

# Google OAuth 2.0 Web Client ID (matches the client ID used by the frontend)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Allowed frontend domains for CORS (comma-separated without trailing slash)
# Include your Vercel deployment domain and any custom domains
CLIENT_URL=https://your-project.vercel.app,http://localhost:3000
